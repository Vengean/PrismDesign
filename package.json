{
  "name": "prism-design",
  "version": "0.1.0",
  "private": true,
  "description": "Visual UI editing tool for designers — peek, poke, and refine live pages with AI",
  "scripts": {
    "dev": "pnpm --filter demo dev & pnpm --filter @prism-design/agent dev",
    "dev:agent": "pnpm --filter @prism-design/agent dev",
    "dev:demo": "pnpm --filter demo dev",
    "build:agent": "pnpm --filter @prism-design/agent build",
    "build:devtools": "pnpm --filter @prism-design/devtools build",
    "build:chrome-ext": "pnpm --filter @prism-design/chrome-ext build",
    "build": "pnpm -r build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
