FROM docker.1ms.run/library/node:22-slim

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null; true
RUN apt-get update && apt-get install -y git curl openssh-client && rm -rf /var/lib/apt/lists/*
RUN npm config set registry https://registry.npmmirror.com/
RUN npm install -g pnpm@9
RUN npm install -g @anthropic-ai/claude-code
RUN npm install -g glm-acp-agent@latest
# Install code-server (download deb from GitHub release)
ARG CODE_SERVER_VERSION=4.100.3
RUN ARCH=$(dpkg --print-architecture) && \
    curl -fsSL -o /tmp/code-server.deb \
    "https://gh-proxy.com/https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_${ARCH}.deb" && \
    dpkg -i /tmp/code-server.deb && rm /tmp/code-server.deb

# Install agent
WORKDIR /prism-agent
COPY agent-package.json ./package.json
COPY agent-dist/ ./dist/
RUN npm install --omit=dev

# Create non-root user (claude CLI refuses --dangerously-skip-permissions as root)
RUN useradd -m -s /bin/bash prism && \
    mkdir -p /workspace /var/log/prism && \
    chown prism:prism /workspace /var/log/prism && \
    cp -a /home/prism /home/prism-skel

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace
EXPOSE 5173 8080 9527
USER prism
ENTRYPOINT ["/entrypoint.sh"]
