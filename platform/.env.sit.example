# Copy to .env.sit.local (ignored by Git). DEV continues to use SQLite.
DB_HOST=127.0.0.1
DB_PORT=3306
# The database you already created; the SIT mode does not depend on its name.
DB_NAME=prism_dev
DB_USER=prism
DB_PASSWORD=
SIT_PORT=3002
SIT_PREVIEW_GATEWAY_PORT=3101
# Set a separate SIT login/JWT secret, or import users using migrate:sit.
ADMIN_USER=admin
ADMIN_PASSWORD=
JWT_SECRET=
