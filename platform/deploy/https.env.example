# Platform/Compose settings
PRISM_PLATFORM_URL=https://studio.example.com
PRISM_PREVIEW_DOMAIN=preview.example.net
PRISM_PREVIEW_GATEWAY_PORT=3100
PRISM_PREPARE_TIMEOUT=1800
PRISM_STARTUP_TIMEOUT=120
# Caddy process settings (certificate SANs must cover BOTH names below)
PRISM_PLATFORM_HOST=studio.example.com
PRISM_TLS_CERT=/etc/prism/tls/fullchain.pem
PRISM_TLS_KEY=/etc/prism/tls/privkey.pem
