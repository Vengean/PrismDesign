{
  "name": "@prism-studio-ai/serve",
  "version": "0.4.0",
  "description": "Serve static files with the Prism Studio AI widget — comment and chat with AI to modify source code",
  "type": "module",
  "license": "MIT",
  "bin": {
    "prism-studio-serve": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts --dir ../demo/dist",
    "build": "pnpm build:cli && pnpm build:widget",
    "build:cli": "tsup",
    "build:widget": "vite build"
  },
  "keywords": [
    "prism-studio",
    "static-server",
    "ai",
    "design",
    "visual-editing",
    "widget"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/prism-studio"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "open": "^10.0.0"
  },
  "peerDependencies": {
    "@prism-studio-ai/agent": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@prism-studio-ai/agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
