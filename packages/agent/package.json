{
  "name": "prism-design-agent",
  "version": "0.2.1",
  "description": "AI agent service for PrismDesign — scans project, receives design edits, modifies source code",
  "type": "module",
  "license": "MIT",
  "bin": {
    "prism-design-agent": "./dist/cli.js"
  },
  "exports": {
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts start",
    "build": "tsup",
    "start": "node dist/cli.js start"
  },
  "keywords": [
    "prism-design",
    "ai",
    "design",
    "visual-editing",
    "agent",
    "ui",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/prism-design"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.118",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
